<!--
CurrentRobotPanel - 当前操控机器人状态面板

行1：名称 + 性能体系
行2：血条 + 血量
行3：等级、升级经验、发弹量
-->
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:local="using:Alliance.Client.Shared.Utils"
             x:Class="Alliance.Client.Features.Hud.CurrentRobotPanel"
             x:DataType="telemetry:CurrentRobotPanelSnapshot"
             mc:Ignorable="d"
             xmlns:telemetry="using:Alliance.Client.Features.Telemetry">
    <Border Classes="hud-panel-accent">
        <Grid RowDefinitions="*,*,*" RowSpacing="4">
            <Grid Grid.Row="0" ColumnDefinitions="*,Auto" ColumnSpacing="8">
                <TextBlock Classes="hud-value" FontSize="15"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"
                           Text="{Binding RobotLabel}" />
                <TextBlock Grid.Column="1" Classes="hud-value" FontSize="12"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource AccentBrush}"
                           Text="{Binding PerformanceText}" />
            </Grid>

            <Grid Grid.Row="1" ColumnDefinitions="*,Auto" ColumnSpacing="6">
                <Border x:Name="HealthBarBg" Classes="hud-bar-bg-lg" Grid.Column="0" VerticalAlignment="Center">
                    <Border Classes="hud-bar-fill-lg"
                            Background="{Binding BarColorClass, Converter={x:Static local:HealthBarBrushConverter.Instance}}"
                            HorizontalAlignment="Left">
                        <Border.Width>
                            <MultiBinding Converter="{x:Static local:PercentToWidthConverter.Instance}">
                                <Binding Path="HealthPercent" />
                                <Binding Path="#HealthBarBg.Bounds.Width" />
                            </MultiBinding>
                        </Border.Width>
                    </Border>
                </Border>
                <TextBlock Grid.Column="1" Classes="hud-value" FontSize="15"
                           VerticalAlignment="Center"
                           Text="{Binding HealthText}" />
            </Grid>

            <Grid Grid.Row="2" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                <TextBlock Classes="hud-value" FontSize="14"
                           VerticalAlignment="Center"
                           Text="{Binding LevelText}" />
                <TextBlock Grid.Column="1" Classes="hud-value" FontSize="14"
                           VerticalAlignment="Center"
                           Text="{Binding UpgradeNeededText}" />
                <TextBlock Grid.Column="2" Classes="hud-value" FontSize="14"
                           VerticalAlignment="Center"
                           Text="{Binding AmmoText}" />
            </Grid>
        </Grid>
    </Border>
</UserControl>
